# Copy only the selected provider section to a local .env; never commit secrets.
# CLI arguments override process environment, then dotenv, then TOML profiles.
QSTACK_MODE=local

# IBM Cloud + Runtime
QSTACK_IBM_API_KEY=replace-with-api-key
QSTACK_IBM_INSTANCE_CRN=replace-with-instance-crn
QSTACK_IBM_DEVICE=ibm_fez

# Google ADC: create credentials using the documented Google login flow.
GOOGLE_APPLICATION_CREDENTIALS=C:/quantum/google-service-account.json
QSTACK_GOOGLE_PROJECT=replace-with-project
QSTACK_GOOGLE_DEVICE=replace-with-discovered-processor

# Nexus browser login; SDK manages refresh credentials.
QSTACK_QUANTINUUM_PROJECT=replace-with-project
QSTACK_QUANTINUUM_REGION=uk
QSTACK_QUANTINUUM_DEVICE=H2-1E

# Azure: service principal shown; managed identity/default credentials also work.
AZURE_TENANT_ID=replace-with-tenant
AZURE_CLIENT_ID=replace-with-client-id
AZURE_CLIENT_SECRET=replace-with-client-secret
QSTACK_AZURE_WORKSPACE_RESOURCE_ID=/subscriptions/REPLACE/resourceGroups/REPLACE/providers/Microsoft.Quantum/Workspaces/REPLACE
QSTACK_AZURE_DEVICE=quantinuum.sim.h2-1e

# AWS SDK profile/SSO supplies the credentials, without a direct-provider key.
AWS_PROFILE=quantum
AWS_DEFAULT_REGION=us-east-1
QSTACK_AWS_DEVICE=replace-with-discovered-device-arn
QSTACK_AWS_S3_URI=s3://replace-with-bucket/results

QSTACK_IONQ_API_KEY=replace-with-key
QSTACK_IONQ_DEVICE=replace-with-discovered-backend
QSTACK_RIGETTI_SDK_PROFILE=default
QSTACK_RIGETTI_DEVICE=replace-with-processor
QSTACK_IQM_URL=https://replace-with-server
QSTACK_IQM_TOKEN=replace-with-bearer-token
QSTACK_IQM_QUANTUM_COMPUTER=replace-with-computer
QSTACK_OQC_URL=https://replace-with-qcaas-server
QSTACK_OQC_ACCESS_TOKEN=replace-with-portal-token
QSTACK_OQC_DEVICE=replace-with-qpu-id
QSTACK_OQC_CAPABILITY_SNAPSHOT=C:/quantum/oqc-capabilities.json
QSTACK_AQT_TOKEN=replace-with-arnica-token
QSTACK_AQT_WORKSPACE=replace-with-workspace
QSTACK_AQT_RESOURCE=replace-with-resource
QSTACK_ANYON_HOST=https://replace-with-host
QSTACK_ANYON_USER=replace-with-user
QSTACK_ANYON_ACCESS_TOKEN=replace-with-access-token
QSTACK_ANYON_PROJECT=replace-with-project
QSTACK_ANYON_DEVICE=replace-with-machine
QSTACK_ALICEBOB_API_KEY=replace-with-felis-key
QSTACK_ALICEBOB_DEVICE=replace-with-felis-target

# Optional lab execution only; no Falcon cloud service is implied.
QSTACK_QIBOLAB_PLATFORM=C:/quantum/calibrated-platform
# Optional override for custom instruments or native operations:
# QSTACK_QIBOLAB_BRIDGE=my_lab.bridge:create
